<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>BTify</title>
        <link rel="stylesheet" type="text/css" href="style.css" />
    </head>
    <body>
        <!-- Top Bar -->
        <div class="topbar">
            <p class="os-name" id="welcomeopen">BTify OS</p>
            <p id="timeElement">Time</p>
        </div>
        <!-- Window -->
        <div class="window" id="welcome">
            <div class="windowheader" id="welcomeheader">
                <div class="closebutton" id="welcomeclose"></div>
                <p class="headertext">Welcome</p>
                <div style="width: 16px;"></div>
            </div>
            <h1>Welcome to BTify!</h1>
            <p>This is the webfront for BTify! A project that uses python to view devices!</p>
            <img src="./images/BTifylogo.png" />
            <div class="content-box">
                <p>Explore your devices and more!</p>
                <a href="https://flavortown.hackclub.com/projects/4102">Flavortown</a><a href="./images/out-of-pocket.png">/</a><a href="https://github.com/diliboy88/BTify.">GitHub Repo</a>
            </div>
        </div>
        <!-- Desktop Apps -->
        <div id="desktopApps" style="padding-top: 64px; padding-left: 16px;">
            <div id="devicesIcon" class="app-icon" style="text-align: center; padding: 16px; filter: drop-shadow(0 0 8px black); width: fit-content;">
                <img src="./images/devicelogo.png" style="width: 64px; height: 64px; border-radius: 16px; object-fit: cover;">
                <p style="margin: 0px; color: #fff;">Devices</p>
            </div>
        </div>
        <!-- Devices Window -->
        <div class="window" id="devices" style="top: calc(50% - 90px); left: calc(50% - 180px); display: none;">
            <div class="windowheader" id="devicesheader">
                <div class="closebutton" id="devicesclose"></div>
                <p class="headertext">Devices</p>
                <div style="width: 16px;"></div>
            </div>
            <div id="devicesContent"
                 style="background-color: #fff; margin: 6px; border-radius: 12px; width: 290px; height: 450px; padding: 16px; overflow-y: scroll;">
                <p>lowkey give me a minute...</p>
            </div>
        </div>
        <script src="script.js"></script>
        <div id="changelogApp" style="padding-top: 64px; padding-left:16px;">
            <div id="changelogIcon" class="app-icon" style="text-align: center; padding: 16px; filter: drop-shadow(0 0 8px black); width: fit-content;">
                <img src="./images/out-of-pocket.png" style="width: 64px; height: 64px; border-radius: 16px; object-fit: cover;">
                <p style="margin: 0px; color: #fff;">Changelog</p> 
    
    
    
    
    </body>
</html>          